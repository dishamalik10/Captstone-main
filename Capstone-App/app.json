{
  "expo": {
    "name": "AURA",
    "slug": "fashion-wardrobe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "wearbefore",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AURA needs camera access to photograph wardrobe items.",
        "NSPhotoLibraryUsageDescription": "AURA needs photo library access to upload wardrobe items."
      }
    },
    "android": {
      "package": "com.aurastylist.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E0D0B"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA needs access to your photos to upload wardrobe items."
        }
      ],
      "expo-status-bar"
    ]
  }
}
