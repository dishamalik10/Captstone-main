# Local chat model (GGUF); inference never downloads weights automatically.
AURA_LLM_MODEL_PATH=./model_artifacts/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
AURA_FASHION_LM_PATH=./model_artifacts/aura_fashion_gpt_final
AURA_LLM_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
AURA_LLM_CONTEXT_LENGTH=4096
AURA_LLM_MAX_INPUT_TOKENS=3072
AURA_LLM_MAX_OUTPUT_TOKENS=384
AURA_LLM_CONCURRENCY=1
AURA_LLM_QUEUE_TIMEOUT_SECONDS=30
AURA_LLM_THREADS=4
AURA_LLM_GPU_LAYERS=-1
AURA_LLM_TEMPERATURE=0.4
AURA_LLM_TOP_P=0.9
AURA_DATASET_PATH=./training/data/prepared
AURA_CHECKPOINT_PATH=./training/checkpoints
OPENWEATHER_API_KEY=
AURA_DATABASE_PATH=./aura.db
AURA_UPLOAD_DIR=./uploads
AURA_MEDIA_SIGNING_KEY=
AURA_MODEL_PATH=./model_artifacts/fashion_cnn_final.keras
AURA_METADATA_PATH=./model_artifacts/fashion_cnn.metadata.json
AURA_COMPATIBILITY_MODEL_PATH=./model_artifacts/shift15m_compatibility_safe.keras
AURA_COMPATIBILITY_VOCAB_PATH=./model_artifacts/shift15m_subcategory_vocab.json
AURA_TREND_CACHE_PATH=./model_artifacts/fashion_trends.cache.json
AURA_ALLOWED_ORIGINS=*
AURA_MAX_UPLOAD_BYTES=10485760
# Hybrid stylist (see training/HYBRID_STYLIST.md)
AURA_OUTFIT_COMPAT_WEIGHTS=./model_artifacts/outfit_compat/outfit_compat.weights.h5
AURA_OUTFIT_COMPAT_CONFIG=./model_artifacts/outfit_compat/outfit_compat.config.json
AURA_OUTFIT_COMPAT_WEIGHT=0.40
AURA_STYLIST_LLM_PATH=./model_artifacts/llm/aura-stylist-q4_k_m.gguf
AURA_STYLIST_LLM_ENABLED=1
# Serve chat from the fine-tuned stylist GGUF when installed (0 = base Qwen chat)
AURA_CHAT_USE_STYLIST=1
