# Local chat model (GGUF); inference never downloads weights automatically.
AURA_LLM_MODEL_PATH=./model_artifacts/llm/qwen2.5-3b-instruct-q4_k_m.gguf
AURA_FASHION_LM_PATH=./model_artifacts/aura_fashion_gpt_final
AURA_LLM_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
AURA_LLM_CONTEXT_LENGTH=4096
AURA_LLM_MAX_INPUT_TOKENS=3072
AURA_LLM_MAX_OUTPUT_TOKENS=384
AURA_LLM_CONCURRENCY=1
AURA_LLM_QUEUE_TIMEOUT_SECONDS=30
AURA_LLM_THREADS=4
AURA_LLM_GPU_LAYERS=-1
AURA_LLM_TEMPERATURE=0.4
AURA_LLM_TOP_P=0.9
AURA_DATASET_PATH=./training/data/prepared
AURA_CHECKPOINT_PATH=./training/checkpoints
OPENWEATHER_API_KEY=
AURA_DATABASE_PATH=./aura.db
AURA_UPLOAD_DIR=./uploads
# Required. Generate once and keep it: python -c "import secrets; print(secrets.token_hex(32))"
AURA_MEDIA_SIGNING_KEY=
# Rotating log file location (INFO and above); the terminal shows warnings and errors only.
AURA_LOG_DIR=./logs
AURA_MODEL_PATH=./model_artifacts/fashion_cnn_final.keras
AURA_METADATA_PATH=./model_artifacts/fashion_cnn.metadata.json
AURA_COMPATIBILITY_MODEL_PATH=./model_artifacts/shift15m_compatibility_safe.keras
AURA_COMPATIBILITY_VOCAB_PATH=./model_artifacts/shift15m_subcategory_vocab.json
AURA_TREND_CACHE_PATH=./model_artifacts/fashion_trends.cache.json
# Browser origins allowed to call the API. "*" only for local development; for the
# public release use exactly the web app, e.g. AURA_ALLOWED_ORIGINS=https://app.yourdomain.com
AURA_ALLOWED_ORIGINS=*
AURA_MAX_UPLOAD_BYTES=10485760
# Heavy image jobs (CNN, garment cut-out, body analysis) allowed at once; more wait, then get 503.
AURA_IMAGE_CONCURRENCY=2
# ---------------------------------------------------------------------------------
# MACHINE PROFILE - pick ONE. Everyone cloning the repo: read the README section
# "Which settings for my Mac?". The values below are the 8 GB TESTER profile (also the
# code's defaults).
#
#   8 GB Mac (teammates, testing):   AURA_TRYON_ENABLED=0   AURA_PRELOAD_VISION=0
#     Everything works except virtual try-on, which shows "turned off on this server".
#     The garment CNN loads on the first upload (that upload takes a few seconds longer).
#   16 GB Mac (the public host):     AURA_TRYON_ENABLED=1   AURA_PRELOAD_VISION=1
#
# Testing try-on on an 8 GB Mac: set AURA_TRYON_ENABLED=1, close other apps, and expect
# slow renders and heavy swap (a render needs ~6 GB with the API). Not yet measured on 8 GB.
AURA_TRYON_ENABLED=0
AURA_PRELOAD_VISION=0
# ---------------------------------------------------------------------------------
# The API starts the try-on worker process itself when try-on is on and its models are installed.
# 4.11: widen the try-on mask for roomy sizes. Off until renders show it helps (see ENGINEERING_PLAN).
AURA_TRYON_FIT_WIDEN=0
AURA_TRYON_MAX_ACTIVE_PER_USER=1
AURA_TRYON_DAILY_LIMIT=3
AURA_TRYON_QUEUE_LIMIT=10
AURA_TRYON_RETENTION_DAYS=7
# Cut garments out in a short-lived child process so its ~2 GB is freed before rendering.
AURA_TRYON_ISOLATE_CUTOUT=1
# Hybrid stylist (see training/HYBRID_STYLIST.md)
AURA_OUTFIT_COMPAT_WEIGHTS=./model_artifacts/outfit_compat/outfit_compat.weights.h5
AURA_OUTFIT_COMPAT_CONFIG=./model_artifacts/outfit_compat/outfit_compat.config.json
AURA_OUTFIT_COMPAT_WEIGHT=0.15
AURA_STYLIST_LLM_PATH=./model_artifacts/llm/aura-stylist-q4_k_m.gguf
AURA_STYLIST_LLM_ENABLED=1
# 1 (default) = the fine-tuned stylist also writes chat replies and the recommendation
# comparison, so only one ~1 GB model is in memory (needed on an 8 GB host).
# 0 = use the base chat model above (Qwen2.5-3B, ~2.1 GB) for those instead.
AURA_CHAT_USE_STYLIST=1
# Personalised ranking: per-user contextual bandit learned from like/dislike/save/wear feedback
AURA_BANDIT_ENABLED=1
